#!/usr/bin/env bash

PIDFILE="/var/run/my_process.pid"
SCRIPT="/root/holbertonschool-shell/processes_and_signals/manage_my_process"

start() {
    $SCRIPT &
    echo $! > "$PIDFILE"
    echo "manage_my_process started"
}

stop() {
    if [ -f "$PIDFILE" ]; then
        kill "$(cat $PIDFILE)" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    echo "manage_my_process stopped"
}

restart() {
    stop
    start
    echo "manage_my_process restarted"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        ;;
esac

